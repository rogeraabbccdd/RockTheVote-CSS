<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/rockthevote.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/rockthevote_maps.vcss_c" />
	</styles>
	<Panel class="rtv-vote-root" hittest="false">
		<!-- Version marker: invisible in-game, visible in a decompile so a mounted addon's revision can be identified. Bump when editing. -->
		<Label class="rtv-version" text="rockthevote revision 6" hittest="false" />
		<Panel id="rtv_vote_dialog" class="rtv-vote-dialog" hittest="false">
			<Label id="rtv_header" class="rtv-vote-kicker" text="{s:rtv_header}" hittest="false" />
			<Panel class="rtv-vote-options" hittest="false">
				<Button id="rtv_vote_1" class="rtv-vote-row"><Panel id="rtv_img_1" class="rtv-vote-img" hittest="false" /><Label id="rtv_label_1" class="rtv-vote-row-label" text="{s:rtv_option_1}" hittest="false" /><Label id="rtv_count_1" class="rtv-vote-count" text="{s:rtv_count_1}" hittest="false" /></Button>
				<Button id="rtv_vote_2" class="rtv-vote-row"><Panel id="rtv_img_2" class="rtv-vote-img" hittest="false" /><Label id="rtv_label_2" class="rtv-vote-row-label" text="{s:rtv_option_2}" hittest="false" /><Label id="rtv_count_2" class="rtv-vote-count" text="{s:rtv_count_2}" hittest="false" /></Button>
				<Button id="rtv_vote_3" class="rtv-vote-row"><Panel id="rtv_img_3" class="rtv-vote-img" hittest="false" /><Label id="rtv_label_3" class="rtv-vote-row-label" text="{s:rtv_option_3}" hittest="false" /><Label id="rtv_count_3" class="rtv-vote-count" text="{s:rtv_count_3}" hittest="false" /></Button>
				<Button id="rtv_vote_4" class="rtv-vote-row"><Panel id="rtv_img_4" class="rtv-vote-img" hittest="false" /><Label id="rtv_label_4" class="rtv-vote-row-label" text="{s:rtv_option_4}" hittest="false" /><Label id="rtv_count_4" class="rtv-vote-count" text="{s:rtv_count_4}" hittest="false" /></Button>
				<Button id="rtv_vote_5" class="rtv-vote-row"><Panel id="rtv_img_5" class="rtv-vote-img" hittest="false" /><Label id="rtv_label_5" class="rtv-vote-row-label" text="{s:rtv_option_5}" hittest="false" /><Label id="rtv_count_5" class="rtv-vote-count" text="{s:rtv_count_5}" hittest="false" /></Button>
				<Button id="rtv_vote_6" class="rtv-vote-row"><Panel id="rtv_img_6" class="rtv-vote-img" hittest="false" /><Label id="rtv_label_6" class="rtv-vote-row-label" text="{s:rtv_option_6}" hittest="false" /><Label id="rtv_count_6" class="rtv-vote-count" text="{s:rtv_count_6}" hittest="false" /></Button>
				<Button id="rtv_vote_7" class="rtv-vote-row"><Panel id="rtv_img_7" class="rtv-vote-img" hittest="false" /><Label id="rtv_label_7" class="rtv-vote-row-label" text="{s:rtv_option_7}" hittest="false" /><Label id="rtv_count_7" class="rtv-vote-count" text="{s:rtv_count_7}" hittest="false" /></Button>
				<Button id="rtv_vote_8" class="rtv-vote-row"><Panel id="rtv_img_8" class="rtv-vote-img" hittest="false" /><Label id="rtv_label_8" class="rtv-vote-row-label" text="{s:rtv_option_8}" hittest="false" /><Label id="rtv_count_8" class="rtv-vote-count" text="{s:rtv_count_8}" hittest="false" /></Button>
				<Button id="rtv_vote_9" class="rtv-vote-row"><Panel id="rtv_img_9" class="rtv-vote-img" hittest="false" /><Label id="rtv_label_9" class="rtv-vote-row-label" text="{s:rtv_option_9}" hittest="false" /><Label id="rtv_count_9" class="rtv-vote-count" text="{s:rtv_count_9}" hittest="false" /></Button>
				<Button id="rtv_vote_10" class="rtv-vote-row"><Panel id="rtv_img_10" class="rtv-vote-img" hittest="false" /><Label id="rtv_label_10" class="rtv-vote-row-label" text="{s:rtv_option_10}" hittest="false" /><Label id="rtv_count_10" class="rtv-vote-count" text="{s:rtv_count_10}" hittest="false" /></Button>
			</Panel>
			<Label id="rtv_timer" class="rtv-vote-timer" text="{s:rtv_timer}" hittest="false" />
			<Button id="rtv_vote_close" class="rtv-vote-close"><Label class="rtv-vote-close-label" text="Close" hittest="false" /></Button>
		</Panel>
		<!-- Nominate panel: one shared entity, content set per player -->
		<Panel id="rtv_nom_dialog" class="rtv-nom-dialog" hittest="false">
			<Label id="rtv_nom_header" class="rtv-vote-kicker" text="{s:rtv_nom_header}" hittest="false" />
			<Panel class="rtv-nom-grid" hittest="false">
				<Panel id="rtv_nom_row_1" class="rtv-nom-row" hittest="false"><Button id="rtv_nom_card_1" class="rtv-nom-card"><Panel id="rtv_nom_img_1" class="rtv-vote-img rtv-nom-img" hittest="false" /><Label id="rtv_nom_name_1" class="rtv-nom-name" text="{s:rtv_nom_name_1}" hittest="false" /></Button><Button id="rtv_nom_card_2" class="rtv-nom-card"><Panel id="rtv_nom_img_2" class="rtv-vote-img rtv-nom-img" hittest="false" /><Label id="rtv_nom_name_2" class="rtv-nom-name" text="{s:rtv_nom_name_2}" hittest="false" /></Button><Button id="rtv_nom_card_3" class="rtv-nom-card"><Panel id="rtv_nom_img_3" class="rtv-vote-img rtv-nom-img" hittest="false" /><Label id="rtv_nom_name_3" class="rtv-nom-name" text="{s:rtv_nom_name_3}" hittest="false" /></Button><Button id="rtv_nom_card_4" class="rtv-nom-card"><Panel id="rtv_nom_img_4" class="rtv-vote-img rtv-nom-img" hittest="false" /><Label id="rtv_nom_name_4" class="rtv-nom-name" text="{s:rtv_nom_name_4}" hittest="false" /></Button></Panel>
				<Panel id="rtv_nom_row_2" class="rtv-nom-row" hittest="false"><Button id="rtv_nom_card_5" class="rtv-nom-card"><Panel id="rtv_nom_img_5" class="rtv-vote-img rtv-nom-img" hittest="false" /><Label id="rtv_nom_name_5" class="rtv-nom-name" text="{s:rtv_nom_name_5}" hittest="false" /></Button><Button id="rtv_nom_card_6" class="rtv-nom-card"><Panel id="rtv_nom_img_6" class="rtv-vote-img rtv-nom-img" hittest="false" /><Label id="rtv_nom_name_6" class="rtv-nom-name" text="{s:rtv_nom_name_6}" hittest="false" /></Button><Button id="rtv_nom_card_7" class="rtv-nom-card"><Panel id="rtv_nom_img_7" class="rtv-vote-img rtv-nom-img" hittest="false" /><Label id="rtv_nom_name_7" class="rtv-nom-name" text="{s:rtv_nom_name_7}" hittest="false" /></Button><Button id="rtv_nom_card_8" class="rtv-nom-card"><Panel id="rtv_nom_img_8" class="rtv-vote-img rtv-nom-img" hittest="false" /><Label id="rtv_nom_name_8" class="rtv-nom-name" text="{s:rtv_nom_name_8}" hittest="false" /></Button></Panel>
				<Panel id="rtv_nom_row_3" class="rtv-nom-row" hittest="false"><Button id="rtv_nom_card_9" class="rtv-nom-card"><Panel id="rtv_nom_img_9" class="rtv-vote-img rtv-nom-img" hittest="false" /><Label id="rtv_nom_name_9" class="rtv-nom-name" text="{s:rtv_nom_name_9}" hittest="false" /></Button><Button id="rtv_nom_card_10" class="rtv-nom-card"><Panel id="rtv_nom_img_10" class="rtv-vote-img rtv-nom-img" hittest="false" /><Label id="rtv_nom_name_10" class="rtv-nom-name" text="{s:rtv_nom_name_10}" hittest="false" /></Button><Button id="rtv_nom_card_11" class="rtv-nom-card"><Panel id="rtv_nom_img_11" class="rtv-vote-img rtv-nom-img" hittest="false" /><Label id="rtv_nom_name_11" class="rtv-nom-name" text="{s:rtv_nom_name_11}" hittest="false" /></Button><Button id="rtv_nom_card_12" class="rtv-nom-card"><Panel id="rtv_nom_img_12" class="rtv-vote-img rtv-nom-img" hittest="false" /><Label id="rtv_nom_name_12" class="rtv-nom-name" text="{s:rtv_nom_name_12}" hittest="false" /></Button></Panel>
			</Panel>
			<Panel class="rtv-nom-foot" hittest="false">
				<Button id="rtv_nom_prev" class="rtv-nom-btn"><Label class="rtv-vote-close-label" text="&lt;" hittest="false" /></Button>
				<Label id="rtv_nom_page" class="rtv-nom-page" text="{s:rtv_nom_page}" hittest="false" />
				<Button id="rtv_nom_next" class="rtv-nom-btn"><Label class="rtv-vote-close-label" text="&gt;" hittest="false" /></Button>
				<Button id="rtv_nom_close" class="rtv-vote-close rtv-nom-close"><Label class="rtv-vote-close-label" text="Close" hittest="false" /></Button>
			</Panel>
		</Panel>
		<!-- RTV in-progress toast  -->
		<Panel id="rtv_toast" class="rtv-toast" hittest="false">
			<Label id="rtv_toast_header" class="rtv-toast-header" text="{s:rtv_toast_header}" hittest="false" />
			<Panel class="rtv-toast-desc-row" hittest="false">
				<Label id="rtv_toast_desc" class="rtv-toast-text" text="{s:rtv_toast_desc}" hittest="false" />
				<Label id="rtv_toast_desc_num" class="rtv-toast-text rtv-toast-desc-num" text="{s:rtv_toast_desc_num}" hittest="false" />
			</Panel>
			<Panel class="rtv-toast-instr-row" hittest="false">
				<Label id="rtv_toast_instr" class="rtv-toast-text" text="{s:rtv_toast_instr}" hittest="false" />
				<Label id="rtv_toast_instr_cmd" class="rtv-toast-text rtv-toast-instr-cmd" text="{s:rtv_toast_instr_cmd}" hittest="false" />
				<Label id="rtv_toast_instr_post" class="rtv-toast-text" text="{s:rtv_toast_instr_post}" hittest="false" />
			</Panel>
			<Panel id="rtv_toast_bar_track" class="rtv-toast-bar-track" hittest="false">
				<Panel id="rtv_toast_bar" class="rtv-toast-bar" hittest="false" />
			</Panel>
		</Panel>
	</Panel>
</root>
